# SANGAD — Environment variables
# Copy to .env and fill all values.
# Secrets are marked 🔒 — never commit to Git.

# === Stack identity ===
SANGAD_APP_NAME=SANGAD
SANGAD_APP_DOMAIN=app.sangad.in          # Q-13: set your domain(s)
SANGAD_CORS_ORIGINS=https://${SANGAD_APP_DOMAIN}

# === Database (PostgreSQL 16) — Coolify DB resource ===
POSTGRES_HOST=sangad-postgres
POSTGRES_PORT=5432
POSTGRES_DB=sangad
POSTGRES_USER=sangad_app
POSTGRES_PASSWORD=                          # 🔒
# read-only role for audit-log append-only guarantee 🔒
POSTGRES_AUDIT_USER=sangad_audit
POSTGRES_AUDIT_PASSWORD=                    # 🔒

# === Redis — Coolify DB resource ===
REDIS_HOST=sangad-redis
REDIS_PORT=6379
REDIS_DB=0

# === Session ===
SESSION_SECRET_KEY=                        # 🔒 random 64-byte hex
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_COOKIE_NAME=sangad_sid

# === Auth ===
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_OTP_LENGTH=6
AUTH_OTP_EXPIRY_MINUTES=5
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_LOGIN_LOCKOUT_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_MINUTES=15

# === SMTP (Hostinger) — C-03 ===
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=admin@${SANGAD_APP_DOMAIN}      # 🔒
SMTP_PASSWORD=                             # 🔒
SMTP_FROM_NAME=SANGAD Admin
SMTP_FROM_EMAIL=noreply@${SANGAD_APP_DOMAIN}
SMTP_THROTTLE_PER_HOUR=30                  # Q-12: confirm with Hostinger

# === File storage (S3-compatible) — ADR-15 ===
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com  # Q-20: set your provider/region
S3_REGION=ap-south-1
S3_BUCKET=sangad-files                    # Q-20: set your bucket name
S3_ACCESS_KEY_ID=                          # 🔒
S3_SECRET_ACCESS_KEY=                      # 🔒
S3_DISABLE_SSL=false
# Dev fallback (set to "local" to use filesystem instead of S3)
FILE_STORAGE_BACKEND=s3

# === Field-level encryption (AES-GCM) ===
# 🔒 Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Escrow a copy offline — losing it makes Aadhaar unrecoverable (R-21)
FIELD_ENCRYPTION_KEY=                     # 🔒

# === Payslip ===
PAYSLIP_BATCH_MAX=50
PAYSLIP_DEFAULT_CURRENCY=INR
VOUCHER_THRESHOLD=2000                    # Q-04

# === Extraction (bill OCR) ===
# Primary: LLM vision provider. Options: "llm" or "local"
EXTRACTION_BACKEND=llm
LLM_PROVIDER=openai
LLM_API_KEY=                              # 🔒
LLM_MODEL=gpt-4o
# Fallback local OCR — requires Tesseract/PaddleOCR installed in image
LOCAL_OCR_LANG=eng+hin

# === WhatsApp — OpenWA gateway (ADR-12) ===
# These are set in Coolify env; consumed by both api and worker
OPENWA_BASE_URL=http://openwa:3000
OPENWA_API_KEY=                           # 🔒 scoped API key minted in OpenWA
OPENWA_WEBHOOK_SECRET=                    # 🔒 HMAC secret for webhook signature
OPENWA_SESSION_NAME=sangad-gateway
OPENWA_REPLY_TIMEOUT_SECONDS=15
WHATSAPP_ALLOWED_NUMBERS=                 # comma-separated, e.g. +919000000001,+919000000002

# === Queue (RQ) ===
RQ_QUEUE_NAME=sangad-jobs
RQ_JOB_TIMEOUT=600
RQ_RESULT_TTL=3600

# === Observability ===
LOG_LEVEL=INFO
LOG_FORMAT=json                           # "json" or "text"
SENTRY_DSN=                               # 🔒 optional

# === Master user (created on first run) ===
MASTER_USERNAME=admin
MASTER_PASSWORD=                          # 🔒 will be hashed
MASTER_EMAIL=admin@${SANGAD_APP_DOMAIN}